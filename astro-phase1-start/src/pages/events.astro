---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';

const events = await getCollection('events');
const ordered = events.sort((a, b) => a.data.startDate.getTime() - b.data.startDate.getTime());

const formatDateRange = (start: Date, end?: Date) => {
  const options: Intl.DateTimeFormatOptions = { month: 'short', day: 'numeric', year: 'numeric' };
  const startText = start.toLocaleDateString(undefined, options);
  if (!end) return startText;
  const sameMonth = start.getMonth() === end.getMonth() && start.getFullYear() === end.getFullYear();
  const endOptions: Intl.DateTimeFormatOptions = sameMonth ? { day: 'numeric', year: 'numeric' } : options;
  const endText = end.toLocaleDateString(undefined, endOptions);
  return `${startText} – ${endText}`;
};
---
<Layout title="Events">
  <h1 class="text-2xl font-semibold">Events & Workshops</h1>
  <ul class="mt-4 space-y-3">
    {ordered.map((event) => (
      <li class="card">
        <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-2">
          <div>
            <a href={`/events/${event.slug}`} class="font-medium hover:text-white">
              {event.data.title}
            </a>
            <p class="text-sm text-neutral-300">{event.data.summary}</p>
          </div>
          <div class="text-sm text-neutral-400 md:text-right">
            <div>{formatDateRange(event.data.startDate, event.data.endDate)}</div>
            <div>{event.data.location}</div>
          </div>
        </div>
        {event.data.registrationUrl && (
          <a class="mt-3 inline-flex text-sm text-neutral-200 hover:text-white" href={event.data.registrationUrl}>
            Register →
          </a>
        )}
      </li>
    ))}
  </ul>
</Layout>
