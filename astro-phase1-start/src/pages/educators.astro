---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import CardGrid from '../components/CardGrid.astro';

const modules = await getCollection('modules');
const moduleCards = modules
  .sort((a, b) => a.data.order - b.data.order)
  .map((entry) => ({
    title: entry.data.title,
    href: `/modules/${entry.slug}`,
    description: entry.data.summary,
    meta: `Module ${entry.data.order}`,
  }));

const lessons = await getCollection('lessons');
const lessonCards = lessons.map((entry) => ({
  title: entry.data.title,
  href: `/lessons/${entry.slug}`,
  description: entry.data.summary,
  meta: entry.data.duration,
}));
---
<Layout title="Educator Hub">
  <section>
    <h1 class="text-2xl font-semibold">Educator Hub</h1>
    <p class="mt-2 text-neutral-300">Lesson plans, slides, projects, and worksheets sourced from the book modules. Use the upcoming filters and search to drill into the materials you need.</p>
  </section>
  <CardGrid title="Modules" items={moduleCards} moreHref="/modules" />
  <CardGrid title="Lesson Library" items={lessonCards} moreHref="/lessons" />
</Layout>
