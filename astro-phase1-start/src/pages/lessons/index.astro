---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

const [lessons, modules] = await Promise.all([
  getCollection('lessons'),
  getCollection('modules'),
]);

const moduleLookup = new Map(modules.map((entry) => [entry.id, entry]));
const ordered = lessons.sort((a, b) => {
  const moduleA = moduleLookup.get(a.data.module)?.data.order ?? 0;
  const moduleB = moduleLookup.get(b.data.module)?.data.order ?? 0;
  if (moduleA === moduleB) return a.slug.localeCompare(b.slug);
  return moduleA - moduleB;
});
---
<Layout title="Lessons">
  <section>
    <h1 class="text-2xl font-semibold">Lesson Library</h1>
    <p class="mt-2 text-neutral-300">Browse lesson plans by module. Each entry links to supporting resources and activities.</p>
  </section>
  <div class="mt-6 grid md:grid-cols-2 gap-4">
    {ordered.map((lesson) => {
      const module = moduleLookup.get(lesson.data.module);
      return (
        <article class="card flex flex-col gap-3">
          <div>
            <h2 class="text-lg font-medium">
              <a href={`/lessons/${lesson.slug}`} class="hover:text-white">{lesson.data.title}</a>
            </h2>
            {module && <p class="text-xs uppercase tracking-wide text-neutral-500">Module {module.data.order}</p>}
          </div>
          <p class="text-sm text-neutral-300">{lesson.data.summary}</p>
          <div class="flex items-center justify-between text-xs text-neutral-400">
            <span>{lesson.data.duration}</span>
            {lesson.data.tags.length > 0 && <span>{lesson.data.tags.join(' · ')}</span>}
          </div>
        </article>
      );
    })}
  </div>
</Layout>
