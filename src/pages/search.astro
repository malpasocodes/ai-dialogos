---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Search">
  <Fragment slot="head">
    <meta name="robots" content="noindex" />
  </Fragment>
  <section class="py-6">
    <header class="space-y-2">
      <h1 class="text-3xl font-semibold">Search</h1>
      <p class="text-muted-foreground">Type a keyword to search across the site.</p>
    </header>
    <div class="mt-8 max-w-2xl">
      <div class="flex flex-col gap-4">
        <label class="text-sm font-medium text-muted-foreground" for="site-search-input">Search query</label>
        <div class="relative">
          <input
            id="site-search-input"
            data-search-input
            type="search"
            placeholder="Search books, podcast, essays..."
            class="w-full rounded-pill border border-border/20 bg-card px-4 py-3 text-base text-foreground placeholder:text-muted-foreground/70 focus:border-border/40 focus:outline-none focus:ring-2 focus:ring-accent/60 focus:ring-offset-2 focus:ring-offset-background"
          />
          <span class="pointer-events-none absolute right-4 top-1/2 -translate-y-1/2 text-sm text-muted-foreground">⌘K</span>
        </div>
        <div class="flex items-center justify-between text-sm text-muted-foreground">
          <p data-search-status>Start typing to search.</p>
          <button type="button" data-clear class="text-muted-foreground hover:text-foreground">Clear</button>
        </div>
        <ul data-search-results class="space-y-4"></ul>
      </div>
    </div>
  </section>
  <script type="module">
    const searchInput = document.querySelector('[data-search-input]');
    const resultsList = document.querySelector('[data-search-results]');
    const statusEl = document.querySelector('[data-search-status]');
    const clearButton = document.querySelector('[data-clear]');

    let pagefindModule;
    const ensurePagefind = async () => {
      if (!pagefindModule) {
        pagefindModule = await import('/pagefind/pagefind.js');
        await pagefindModule.init();
      }
      return pagefindModule;
    };

    let searchToken = 0;

    const renderResults = (items) => {
      resultsList.innerHTML = '';
      if (!items.length) {
        statusEl.textContent = 'No matches found. Try a different keyword.';
        return;
      }

      const fragment = document.createDocumentFragment();
      items.forEach((item) => {
        const li = document.createElement('li');
        li.className = 'card space-y-3';
        li.innerHTML = `
          <a href="${item.url}" class="block text-lg font-semibold text-foreground transition hover:text-primary">${item.meta?.title ?? item.url}</a>
          ${item.excerpt ? `<p class="text-sm leading-relaxed text-muted-foreground">${item.excerpt}</p>` : ''}
        `;
        fragment.appendChild(li);
      });
      resultsList.appendChild(fragment);
      statusEl.textContent = `${items.length} result${items.length === 1 ? '' : 's'} found.`;
    };

    const performSearch = async (query) => {
      const token = ++searchToken;
      const pf = await ensurePagefind();
      const response = await pf.search(query);
      if (token !== searchToken) return;
      if (!response || !response.results) {
        statusEl.textContent = 'Search unavailable.';
        return;
      }

      const items = [];
      for (const result of response.results) {
        const data = await result.data();
        items.push(data);
      }
      renderResults(items);
    };

    let debounceHandle;
    const triggerSearch = (value) => {
      const query = value.trim();
      if (!query) {
        resultsList.innerHTML = '';
        statusEl.textContent = 'Start typing to search.';
        return;
      }
      statusEl.textContent = 'Searching...';
      if (debounceHandle) window.clearTimeout(debounceHandle);
      debounceHandle = window.setTimeout(() => {
        performSearch(query);
      }, 200);
    };

    searchInput.addEventListener('input', (event) => {
      triggerSearch(event.target.value);
    });

    clearButton.addEventListener('click', () => {
      searchInput.value = '';
      resultsList.innerHTML = '';
      statusEl.textContent = 'Start typing to search.';
    });

    window.addEventListener('keydown', (event) => {
      if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k') {
        event.preventDefault();
        searchInput.focus();
      }
    });
  </script>
</Layout>
