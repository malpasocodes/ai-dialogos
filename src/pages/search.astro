---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';

const modules = await getCollection('modules');
const moduleOptions = modules
  .sort((a, b) => a.data.order - b.data.order)
  .map((entry) => ({
    value: entry.slug,
    label: entry.data.title,
    order: entry.data.order,
  }));

const typeOptions = [
  { value: 'module', label: 'Modules' },
  { value: 'lesson', label: 'Lessons' },
  { value: 'resource', label: 'Resources' },
  { value: 'podcast', label: 'Podcast' },
  { value: 'event', label: 'Events' },
];
---
<Layout title="Search">
  <Fragment slot="head">
    <meta name="robots" content="noindex" />
  </Fragment>
  <section class="py-6">
    <header class="space-y-2">
      <h1 class="text-3xl font-semibold">Search the Companion Site</h1>
      <p class="text-neutral-300">Type a keyword and use filters to focus by content type or module.</p>
    </header>
    <div class="mt-8 grid gap-8 lg:grid-cols-[260px_1fr]">
      <aside class="space-y-6">
        <div>
          <h2 class="text-sm font-semibold uppercase tracking-wide text-neutral-400">Filter by type</h2>
          <div class="mt-3 flex flex-wrap gap-2" data-filter-group="type" data-filter-options={JSON.stringify(typeOptions)}></div>
        </div>
        <div>
          <h2 class="text-sm font-semibold uppercase tracking-wide text-neutral-400">Filter by module</h2>
          <div class="mt-3 flex flex-col gap-2" data-filter-group="module" data-filter-options={JSON.stringify(moduleOptions)}></div>
        </div>
      </aside>
      <div class="flex flex-col gap-4">
        <label class="text-sm font-medium text-neutral-300" for="site-search-input">Search query</label>
        <div class="relative">
          <input
            id="site-search-input"
            data-search-input
            type="search"
            placeholder="Search lessons, modules, events..."
            class="w-full rounded-2xl border border-neutral-800 bg-neutral-900 px-4 py-3 text-base text-neutral-100 focus:border-neutral-500 focus:outline-none"
          />
          <span class="pointer-events-none absolute right-4 top-1/2 -translate-y-1/2 text-sm text-neutral-500">⌘K</span>
        </div>
        <div class="flex items-center justify-between text-sm text-neutral-500">
          <p data-search-status>Start typing to explore the content library.</p>
          <button type="button" data-clear class="text-neutral-400 hover:text-white">Clear</button>
        </div>
        <ul data-search-results class="space-y-4"></ul>
      </div>
    </div>
  </section>
  <script type="module">
    const moduleOptions = JSON.parse(document.querySelector('[data-filter-group="module"]').dataset.filterOptions);
    const typeOptions = JSON.parse(document.querySelector('[data-filter-group="type"]').dataset.filterOptions);
    const moduleLookup = Object.fromEntries(moduleOptions.map((option) => [option.value, option]));
    const typeLabels = Object.fromEntries(typeOptions.map((option) => [option.value, option.label]));

    const searchInput = document.querySelector('[data-search-input]');
    const resultsList = document.querySelector('[data-search-results]');
    const statusEl = document.querySelector('[data-search-status]');
    const clearButton = document.querySelector('[data-clear]');

    const activeFilters = {
      type: new Set(),
      module: new Set(),
    };

    const createFilterButton = (label, value, filterName) => {
      const button = document.createElement('button');
      button.type = 'button';
      button.textContent = label;
      button.className =
        'rounded-full border border-neutral-800 px-3 py-1 text-xs uppercase tracking-wide text-neutral-400 transition hover:text-white';
      if (!value) {
        button.dataset.reset = 'true';
      } else {
        button.dataset.value = value;
        button.dataset.filter = filterName;
      }
      return button;
    };

    const renderFilterGroup = (container, filterName, options) => {
      if (filterName === 'type') {
        const allButton = createFilterButton('All types', '', filterName);
        allButton.classList.add('font-medium');
        allButton.addEventListener('click', () => {
          activeFilters.type.clear();
          updateActiveFilterStyles(container, filterName);
          triggerSearch(searchInput.value);
        });
        container.appendChild(allButton);
      }

      options.forEach((option) => {
        const optionValue = option.value ?? option.slug ?? '';
        const optionLabel = option.label ?? option.title ?? optionValue;
        const button = createFilterButton(optionLabel, optionValue, filterName);
        button.addEventListener('click', () => {
          const set = activeFilters[filterName];
          if (set.has(optionValue)) {
            set.delete(optionValue);
          } else {
            if (filterName === 'type') {
              set.clear();
            }
            set.add(optionValue);
          }
          updateActiveFilterStyles(container, filterName);
          triggerSearch(searchInput.value);
        });
        container.appendChild(button);
      });
    };

    const updateActiveFilterStyles = (container, filterName) => {
      container.querySelectorAll('button').forEach((button) => {
        const value = button.dataset.value;
        if (!value) {
          if (filterName === 'type') {
            button.classList.toggle('text-white', activeFilters.type.size === 0);
          }
          return;
        }
        const set = activeFilters[filterName];
        const isActive = set.has(value);
        button.classList.toggle('bg-neutral-800', isActive);
        button.classList.toggle('text-white', isActive);
      });
    };

    const filterGroups = document.querySelectorAll('[data-filter-group]');
    filterGroups.forEach((group) => {
      const filterName = group.dataset.filterGroup;
      const options = JSON.parse(group.dataset.filterOptions);
      renderFilterGroup(group, filterName, options);
      updateActiveFilterStyles(group, filterName);
    });

    let pagefindModule;
    const ensurePagefind = async () => {
      if (!pagefindModule) {
        pagefindModule = await import('/pagefind/pagefind.js');
        await pagefindModule.init();
      }
      return pagefindModule;
    };

    let searchToken = 0;
    let keyboardShortcutBound = false;

    const humanizeType = (value) => typeLabels[value] ?? value ?? 'Page';

    const renderResults = (items) => {
      resultsList.innerHTML = '';
      if (!items.length) {
        statusEl.textContent = 'No matches yet. Try a different keyword or adjust filters.';
        return;
      }

      const fragment = document.createDocumentFragment();
      items.forEach((item) => {
        const li = document.createElement('li');
        li.className = 'card space-y-2';
        const typeLabel = humanizeType(item.filters?.type?.[0]);
        const moduleSlug = item.filters?.module?.[0];
        const moduleLabel = item.meta?.module_title ?? moduleLookup[moduleSlug]?.label;
        const tags = item.meta?.tags;
        const secondaryMeta = [moduleLabel, item.meta?.resource_type?.replace('-', ' '), item.meta?.duration]
          .filter(Boolean)
          .join(' • ');

        li.innerHTML = `
          <div class="flex items-center justify-between gap-3">
            <span class="text-xs uppercase tracking-wide text-neutral-400">${typeLabel}</span>
            ${moduleLabel ? `<span class="text-xs uppercase tracking-wide text-neutral-500">${moduleLabel}</span>` : ''}
          </div>
          <a href="${item.url}" class="block text-lg font-medium hover:text-white">${item.meta?.title ?? item.url}</a>
          ${item.excerpt ? `<p class="text-sm text-neutral-300 leading-relaxed">${item.excerpt}</p>` : ''}
          ${
            secondaryMeta
              ? `<p class="text-xs uppercase tracking-wide text-neutral-500">${secondaryMeta}</p>`
              : ''
          }
          ${
            tags
              ? `<div class="flex flex-wrap gap-2 text-xs uppercase tracking-wide text-neutral-500">${tags
                  .split(',')
                  .map((tag) => `<span class="rounded-full border border-neutral-700 px-3 py-1">${tag.trim()}</span>`)
                  .join('')}</div>`
              : ''
          }
        `;
        fragment.appendChild(li);
      });
      resultsList.appendChild(fragment);
      statusEl.textContent = `${items.length} result${items.length === 1 ? '' : 's'} found.`;
    };

    const performSearch = async (query) => {
      const token = ++searchToken;
      const pf = await ensurePagefind();

      const filters = {};
      if (activeFilters.type.size) {
        filters.type = Array.from(activeFilters.type);
      }
      if (activeFilters.module.size) {
        filters.module = Array.from(activeFilters.module);
      }

      const response = await pf.search(query, { filters });
      if (token !== searchToken) return;
      if (!response || !response.results) {
        statusEl.textContent = 'Search unavailable.';
        return;
      }

      const items = [];
      for (const result of response.results) {
        const data = await result.data();
        items.push(data);
      }
      renderResults(items);
    };

    let debounceHandle;
    const triggerSearch = (value) => {
      const query = value.trim();
      statusEl.textContent = 'Searching...';
      if (debounceHandle) window.clearTimeout(debounceHandle);
      debounceHandle = window.setTimeout(() => {
        performSearch(query);
      }, 200);
    };

    searchInput.addEventListener('input', (event) => {
      triggerSearch(event.target.value);
    });

    clearButton.addEventListener('click', () => {
      searchInput.value = '';
      activeFilters.type.clear();
      activeFilters.module.clear();
      filterGroups.forEach((group) => updateActiveFilterStyles(group, group.dataset.filterGroup));
      triggerSearch('');
    });

    const bindKeyboardShortcut = () => {
      if (keyboardShortcutBound) return;
      keyboardShortcutBound = true;
      window.addEventListener('keydown', (event) => {
        if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k') {
          event.preventDefault();
          searchInput.focus();
        }
      });
    };

    bindKeyboardShortcut();
    triggerSearch('');
  </script>
</Layout>
