---
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import CardGrid from '../../components/CardGrid.astro';
import Seo from '../../components/Seo.astro';
import { getPodcastEpisodes } from '../../utils/podcast';

const SITE_URL = import.meta.env.SITE_URL ?? 'https://ai-innov.example.com';

export async function getStaticPaths() {
  const modules = await getCollection('modules');
  return modules.map((module) => ({
    params: { slug: module.slug },
    props: { module },
  }));
}

const { module } = Astro.props as { module: CollectionEntry<'modules'> };
const { Content } = await module.render();

const lessons = await getCollection('lessons', (lesson) => lesson.data.module === module.id);
const lessonCards = lessons.map((entry) => ({
  title: entry.data.title,
  href: `/lessons/${entry.slug}`,
  description: entry.data.summary,
  meta: entry.data.duration,
}));

const resources = await getCollection('resources', (resource) => resource.data.module === module.id);
const resourceCards = resources.map((entry) => ({
  title: entry.data.title,
  href: `/resources/${entry.slug}`,
  description: entry.data.summary,
  meta: entry.data.type.replace('-', ' '),
}));

const podcastEpisodes = (await getPodcastEpisodes()).filter(
  (episode) => episode.moduleSlug === module.slug,
);
const podcastCards = podcastEpisodes.map((episode) => ({
  title: episode.title,
  href: `/podcast/${episode.slug}`,
  description: episode.summary,
  meta: episode.duration,
}));

const events = await getCollection('events', (event) => event.data.module === module.id);
const eventCards = events.map((entry) => ({
  title: entry.data.title,
  href: entry.data.registrationUrl ?? '#',
  description: entry.data.summary,
  meta: entry.data.location,
}));
---
<Layout title={module.data.title} description={module.data.summary}>
  <Fragment slot="head">
    <meta name="pagefind:filter:type" content="module" />
    <meta name="pagefind:filter:module" content={module.slug} />
    <meta name="pagefind:meta:module_title" content={module.data.title} />
    <Seo
      renderMeta={false}
      structuredData={{
        '@type': 'Course',
        name: module.data.title,
        description: module.data.summary,
        url: new URL(Astro.url.pathname, SITE_URL).toString(),
        provider: {
          '@type': 'Organization',
          name: 'AI-Innov',
        },
      }}
    />
  </Fragment>
  <article class="space-y-5" data-pagefind-filter="type:module">
    <span hidden data-pagefind-filter={`module:${module.slug}`}></span>
    <span hidden data-pagefind-meta={`module_title:${module.data.title}`}></span>
    {module.data.tags.length > 0 && <span hidden data-pagefind-meta={`tags:${module.data.tags.join(', ')}`}></span>}
    <h1 class="text-4xl font-semibold text-foreground">{module.data.title}</h1>
    {module.data.subtitle && <p class="text-lg leading-relaxed text-muted">{module.data.subtitle}</p>}
    <p class="text-xs font-medium uppercase tracking-wide text-muted">
      Updated {module.data.updated.toLocaleDateString(undefined, { month: 'short', day: 'numeric', year: 'numeric' })}
      {module.data.tags.length > 0 && ` • ${module.data.tags.join(' · ')}`}
    </p>
    {module.data.focusAreas.length > 0 && (
      <ul class="mt-4 flex flex-wrap gap-2">
        {module.data.focusAreas.map((item) => (
          <li class="badge">{item}</li>
        ))}
      </ul>
    )}
    <div class="mt-6 space-y-3 text-base leading-relaxed text-muted">
      <Content />
    </div>
  </article>
  {lessonCards.length > 0 && <CardGrid title="Lessons" items={lessonCards} moreHref="/lessons" />}
  {resourceCards.length > 0 && <CardGrid title="Resources" items={resourceCards} moreHref="/resources" />}
  {podcastCards.length > 0 && <CardGrid title="Podcast Episodes" items={podcastCards} moreHref="/podcast" />}
  {eventCards.length > 0 && <CardGrid title="Events" items={eventCards} moreHref="/events" />}
</Layout>
