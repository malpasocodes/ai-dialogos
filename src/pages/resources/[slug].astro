---
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Seo from '../../components/Seo.astro';

export async function getStaticPaths() {
  const resources = await getCollection('resources');
  return resources.map((resource) => ({
    params: { slug: resource.slug },
    props: { resource },
  }));
}

const { resource } = Astro.props as { resource: CollectionEntry<'resources'> };
const modules = await getCollection('modules');
const module = resource.data.module ? modules.find((entry) => entry.id === resource.data.module) ?? null : null;
const tags = resource.data.tags;

const SITE_URL = import.meta.env.SITE_URL ?? 'https://ai-innov.example.com';
---
<Layout title={resource.data.title} description={resource.data.summary}>
  <Fragment slot="head">
    <meta name="pagefind:filter:type" content="resource" />
    {module && <meta name="pagefind:filter:module" content={module.slug} />}
    {module && <meta name="pagefind:meta:module_title" content={module.data.title} />}
    <meta name="pagefind:meta:resource_type" content={resource.data.type} />
    {tags.length > 0 && <meta name="pagefind:meta:tags" content={tags.join(', ')} />}
    <Seo
      renderMeta={false}
      structuredData={{
        '@type': 'LearningResource',
        name: resource.data.title,
        description: resource.data.summary,
        url: new URL(Astro.url.pathname, SITE_URL).toString(),
        learningResourceType: resource.data.type,
        inLanguage: 'en',
      }}
    />
  </Fragment>
  <article class="space-y-5" data-pagefind-filter="type:resource">
    {module && <span hidden data-pagefind-filter={`module:${module.slug}`}></span>}
    {module && <span hidden data-pagefind-meta={`module_title:${module.data.title}`}></span>}
    <span hidden data-pagefind-meta={`resource_type:${resource.data.type}`}></span>
    {tags.length > 0 && <span hidden data-pagefind-meta={`tags:${tags.join(', ')}`}></span>}
    <p class="text-xs font-semibold uppercase tracking-wide text-muted">Resource</p>
    <h1 class="text-4xl font-semibold text-foreground">{resource.data.title}</h1>
    <p class="text-base leading-relaxed text-muted">{resource.data.summary}</p>
    <p class="text-xs font-medium uppercase tracking-wide text-muted">
      Updated {resource.data.updated.toLocaleDateString(undefined, { month: 'short', day: 'numeric', year: 'numeric' })}
    </p>
    <div class="flex flex-wrap gap-2 text-xs uppercase tracking-wide text-muted">
      <span class="badge">{resource.data.type.replace('-', ' ')}</span>
      {module && <span class="badge">Module {module.data.order}</span>}
      {tags.map((tag) => (
        <span class="badge">{tag}</span>
      ))}
    </div>
    <div class="flex flex-wrap gap-3">
      <a class="btn-primary" href={resource.data.href} rel="noopener" target="_blank">
        Access resource
      </a>
      {resource.data.download && (
        <a
          class="btn-secondary"
          href={resource.data.download}
          rel="noopener"
          target="_blank"
          data-analytics-event="download_resource"
          data-analytics-value={resource.data.title}
        >
          Download
        </a>
      )}
    </div>
  </article>
</Layout>
