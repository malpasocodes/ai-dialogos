---
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import CardGrid from '../../components/CardGrid.astro';
import Seo from '../../components/Seo.astro';

const SITE_URL = import.meta.env.SITE_URL ?? 'https://ai-innov.example.com';

export async function getStaticPaths() {
  const lessons = await getCollection('lessons');
  return lessons.map((lesson) => ({
    params: { slug: lesson.slug },
    props: { lesson },
  }));
}

const { lesson } = Astro.props as { lesson: CollectionEntry<'lessons'> };
const { Content } = await lesson.render();

const modules = await getCollection('modules');
const module = modules.find((entry) => entry.id === lesson.data.module) ?? null;

const resources = await getCollection('resources', (resource) => lesson.data.resources.includes(resource.id));
const resourceCards = resources.map((entry) => ({
  title: entry.data.title,
  href: `/resources/${entry.slug}`,
  description: entry.data.summary,
  meta: entry.data.type.replace('-', ' '),
}));
---
<Layout title={lesson.data.title} description={lesson.data.summary}>
  <Fragment slot="head">
    <meta name="pagefind:filter:type" content="lesson" />
    {module && <meta name="pagefind:filter:module" content={module.slug} />}
    {module && <meta name="pagefind:meta:module_title" content={module.data.title} />}
    {lesson.data.duration && <meta name="pagefind:meta:duration" content={lesson.data.duration} />}
    <Seo
      renderMeta={false}
      structuredData={{
        '@type': 'LearningResource',
        name: lesson.data.title,
        description: lesson.data.summary,
        url: new URL(Astro.url.pathname, SITE_URL).toString(),
        educationalLevel: lesson.data.level,
        timeRequired: lesson.data.duration,
        provider: module
          ? {
              '@type': 'Organization',
              name: module.data.title,
            }
          : undefined,
      }}
    />
  </Fragment>
  <article class="space-y-5" data-pagefind-filter="type:lesson">
    {module && <span hidden data-pagefind-filter={`module:${module.slug}`}></span>}
    {module && <span hidden data-pagefind-meta={`module_title:${module.data.title}`}></span>}
    {lesson.data.duration && <span hidden data-pagefind-meta={`duration:${lesson.data.duration}`}></span>}
    <span hidden data-pagefind-filter={`level:${lesson.data.level}`}></span>
    <span hidden data-pagefind-meta={`level:${lesson.data.level}`}></span>
    <p class="text-xs font-semibold uppercase tracking-wide text-muted">Lesson Plan</p>
    <h1 class="text-4xl font-semibold text-foreground">{lesson.data.title}</h1>
    <div class="flex flex-wrap gap-3 text-sm font-medium text-muted">
      {module && (
        <span>
          Part of{' '}
          <a href={`/modules/${module.slug}`} class="text-foreground transition hover:text-accent">
            {module.data.title}
          </a>
        </span>
      )}
      {lesson.data.duration && <span class="uppercase tracking-wide">Duration: {lesson.data.duration}</span>}
    </div>
    <p class="text-base leading-relaxed text-muted">{lesson.data.summary}</p>
    <p class="text-xs font-medium uppercase tracking-wide text-muted">
      Updated {lesson.data.updated.toLocaleDateString(undefined, { month: 'short', day: 'numeric', year: 'numeric' })}
      {' • '}
      Level {lesson.data.level.charAt(0).toUpperCase() + lesson.data.level.slice(1)}
    </p>
    <section class="space-y-2">
      <h2 class="text-sm font-semibold uppercase tracking-wide text-muted">Learning objectives</h2>
      <ul class="space-y-1 text-muted">
        {lesson.data.learningObjectives.map((objective) => (
          <li class="flex items-start gap-2">
            <span class="mt-1 h-1.5 w-1.5 rounded-full bg-outline/40" />
            <span>{objective}</span>
          </li>
        ))}
      </ul>
    </section>
    {lesson.data.tags.length > 0 && (
      <div class="flex flex-wrap gap-2 text-xs uppercase tracking-wide text-muted">
        {lesson.data.tags.map((tag) => (
          <span class="badge">{tag}</span>
        ))}
      </div>
    )}
    <div class="space-y-3 text-base leading-relaxed text-muted">
      <Content />
    </div>
  </article>
  {resourceCards.length > 0 && <CardGrid title="Supporting Resources" items={resourceCards} moreHref="/resources" />}
</Layout>
