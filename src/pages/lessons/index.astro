---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

const [lessons, modules] = await Promise.all([
  getCollection('lessons'),
  getCollection('modules'),
]);

const moduleLookup = new Map(modules.map((entry) => [entry.id, entry]));
const ordered = lessons.sort((a, b) => {
  const moduleA = moduleLookup.get(a.data.module)?.data.order ?? 0;
  const moduleB = moduleLookup.get(b.data.module)?.data.order ?? 0;
  if (moduleA === moduleB) return a.slug.localeCompare(b.slug);
  return moduleA - moduleB;
});
---
<Layout title="Lessons">
  <section class="space-y-3">
    <h1 class="text-3xl font-semibold text-foreground">Lesson Library</h1>
    <p class="max-w-2xl text-base leading-relaxed text-muted">
      Browse lesson plans by module. Each entry links to supporting resources and activities.
    </p>
  </section>
  <div class="mt-8 grid gap-5 md:grid-cols-2">
    {ordered.map((lesson) => {
      const module = moduleLookup.get(lesson.data.module);
      return (
        <article class="card flex flex-col gap-3">
          <div>
            <h2 class="text-xl font-semibold text-foreground">
              <a href={`/lessons/${lesson.slug}`} class="transition hover:text-accent">{lesson.data.title}</a>
            </h2>
            <div class="flex flex-wrap gap-2 text-xs font-medium uppercase tracking-wide text-muted">
              {module && <span>Module {module.data.order}</span>}
              <span>{lesson.data.level.charAt(0).toUpperCase() + lesson.data.level.slice(1)}</span>
            </div>
          </div>
          <p class="text-sm leading-relaxed text-muted">{lesson.data.summary}</p>
          <div class="flex items-center justify-between text-xs font-medium uppercase tracking-wide text-muted">
            <span>{lesson.data.duration}</span>
            {lesson.data.tags.length > 0 && <span>{lesson.data.tags.join(' · ')}</span>}
          </div>
        </article>
      );
    })}
  </div>
</Layout>
