---
import Layout from '../../layouts/Layout.astro';
import { getGuests } from '../../utils/guests';

const guests = await getGuests();

Astro.response.headers.set(
  'Cache-Control',
  'public, max-age=60, s-maxage=300, stale-while-revalidate=86400',
);
---
<Layout title="Podcast Guests">
  <section class="space-y-3">
    <h1 class="text-3xl font-semibold text-foreground">Guests</h1>
    <p class="max-w-2xl text-base leading-relaxed text-muted-foreground">
      The AI-Dialogos Podcast will lead off in May and June 2026 with these thought leaders, researchers, and practitioners for conversations on AI strategy, governance, and leadership.
    </p>
  </section>

  <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
    {guests.map((guest) => {
      const preview = guest.shortBio?.trim() || guest.bio;
      const expandable = preview !== guest.bio || guest.bio.length > 220;
      return (
      <article class="card flex flex-col items-center text-center space-y-4">
        {guest.hasHeadshot ? (
          <img
            src={`/api/headshots/${guest.id}`}
            alt={guest.name}
            loading="lazy"
            decoding="async"
            width="96"
            height="96"
            class="h-24 w-24 rounded-full object-cover border border-border"
          />
        ) : (
          <div class="flex h-24 w-24 items-center justify-center rounded-full bg-primary/15 text-2xl font-semibold text-primary">
            {guest.initials}
          </div>
        )}
        <div class="space-y-2 w-full">
          <h2 class="text-lg font-semibold text-foreground">{guest.name}</h2>
          {expandable ? (
            <details class="group">
              <summary class="cursor-pointer list-none [&::-webkit-details-marker]:hidden">
                <p class="text-sm leading-relaxed text-muted-foreground line-clamp-3 group-open:hidden">{preview}</p>
                <span class="mt-1 inline-block text-xs font-medium text-primary group-open:hidden">Read more</span>
                <span class="mt-1 hidden text-xs font-medium text-primary group-open:inline-block">Show less</span>
              </summary>
              <p class="mt-1 text-sm leading-relaxed text-muted-foreground whitespace-pre-line">{guest.bio}</p>
            </details>
          ) : (
            <p class="text-sm leading-relaxed text-muted-foreground whitespace-pre-line">{guest.bio}</p>
          )}
        </div>
        <div class="mt-auto pt-2 w-full border-t border-border/20">
          <p class="text-xs font-medium uppercase tracking-wide text-muted-foreground">Episode</p>
          {guest.episodeTitle ? (
            guest.episodeUrl ? (
              <a
                href={guest.episodeUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="mt-1 inline-block text-sm font-medium text-foreground underline decoration-border underline-offset-4 hover:text-primary hover:decoration-primary"
              >{guest.episodeTitle}</a>
            ) : (
              <p class="mt-1 text-sm font-medium text-foreground">{guest.episodeTitle}</p>
            )
          ) : (
            <p class="mt-1"><span class="inline-block rounded-full bg-primary/15 px-3 py-1 text-xs font-medium text-primary">Coming soon</span></p>
          )}
        </div>
      </article>
      );
    })}
  </div>
</Layout>
