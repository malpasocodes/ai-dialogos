---
import Layout from '../../layouts/Layout.astro';
import Seo from '../../components/Seo.astro';
import { getCollection } from 'astro:content';
import { getPodcastEpisode, getPodcastEpisodes } from '../../utils/podcast';

const SITE_URL = import.meta.env.SITE_URL ?? 'https://ai-innov.example.com';

export async function getStaticPaths() {
  const episodes = await getPodcastEpisodes();
  return episodes.map((episode) => ({
    params: { slug: episode.slug },
  }));
}

const { slug } = Astro.params;
const episode = await getPodcastEpisode(slug);

if (!episode) {
  throw new Error(`Podcast episode not found for slug: ${slug}`);
}

const modules = await getCollection('modules');
const module = episode.moduleSlug
  ? modules.find((entry) => entry.slug === episode.moduleSlug) ?? null
  : null;
---
<Layout title={episode.title} description={episode.summary}>
  <Fragment slot="head">
    <meta name="pagefind:filter:type" content="podcast" />
    {module && <meta name="pagefind:filter:module" content={module.slug} />}
    {module && <meta name="pagefind:meta:module_title" content={module.data.title} />}
    {episode.duration && <meta name="pagefind:meta:duration" content={episode.duration} />}
    <Seo
      renderMeta={false}
      structuredData={{
        '@type': 'PodcastEpisode',
        name: episode.title,
        description: episode.summary,
        url: new URL(Astro.url.pathname, SITE_URL).toString(),
        datePublished: episode.published,
        duration: episode.duration,
        partOfSeries: {
          '@type': 'PodcastSeries',
          name: 'AI-Innov Podcast',
          url: `${SITE_URL}/podcast`,
        },
        audio: {
          '@type': 'AudioObject',
          url: episode.audioUrl,
        },
      }}
    />
  </Fragment>
  <article class="space-y-5" data-pagefind-filter="type:podcast">
    {module && <span hidden data-pagefind-filter={`module:${module.slug}`}></span>}
    {module && <span hidden data-pagefind-meta={`module_title:${module.data.title}`}></span>}
    {episode.duration && <span hidden data-pagefind-meta={`duration:${episode.duration}`}></span>}
    <p class="text-xs font-semibold uppercase tracking-wide text-muted">Podcast Episode</p>
    <h1 class="text-4xl font-semibold text-foreground">{episode.title}</h1>
    <div class="flex flex-wrap gap-3 text-xs font-medium uppercase tracking-wide text-muted">
      <span>{new Date(episode.published).toLocaleDateString(undefined, { month: 'short', day: 'numeric', year: 'numeric' })}</span>
      {episode.duration && <span>• {episode.duration}</span>}
      {module && <span>• Module {module.data.order}</span>}
    </div>
    <p class="text-base leading-relaxed text-muted">{episode.summary}</p>
    <div class="overflow-hidden rounded-2xl border border-outline/20 bg-surface-soft/80 p-3">
      <audio
        class="w-full"
        controls
        src={episode.audioUrl}
        data-analytics-event="play_episode"
        data-analytics-value={episode.title}
      >
        <a href={episode.audioUrl}>Listen to {episode.title}</a>
      </audio>
    </div>
    <div class="flex items-center gap-3 text-sm text-muted">
      <a href={episode.link} target="_blank" rel="noopener" class="btn-secondary">Open show notes</a>
    </div>
  </article>
</Layout>
