---
export const prerender = true;
import Layout from '../layouts/Layout.astro';
import Seo from '../components/Seo.astro';

const SITE_URL = import.meta.env.SITE_URL ?? 'https://ai-dialogos.com';
---
<Layout title="Book">
  <Fragment slot="head">
    <Seo
      renderMeta={false}
      structuredData={{
        '@type': 'Book',
        name: 'Artificial Intelligence: Shaping the Future of Innovation',
        description: 'A concise, non-technical primer on artificial intelligence for business leaders, practitioners, and policymakers.',
        author: {
          '@type': 'Person',
          name: 'Alfred Essa',
        },
        publisher: {
          '@type': 'Organization',
          name: 'De Gruyter',
        },
        datePublished: '2025-01-15',
        url: new URL(Astro.url.pathname, SITE_URL).toString(),
      }}
    />
  </Fragment>
  <section class="prose prose-invert max-w-none">
    <h1>Book</h1>
    <p><strong>Artificial Intelligence: Shaping the Future of Innovation</strong> (De Gruyter, 2025).</p>
    <h2>Table of Contents (Parts)</h2>
    <ol>
      <li>Innovation – AI as a GPT; innovation culture.</li>
      <li>Computation – Algorithms and computer architecture.</li>
      <li>Machine Learning – Core concepts.</li>
      <li>Deep Learning – Big picture and internal mechanics.</li>
      <li>Generative AI – Foundation, expert, and agentic models.</li>
      <li>Risk – Failures and frameworks.</li>
    </ol>
    <!-- TODO: Restore links once sample chapter PDF and purchase URLs are available -->
    <!--
    <p class="not-prose mt-6 flex flex-wrap gap-3">
      <a class="btn-primary" href="/path-to-sample.pdf">Sample Chapter (PDF)</a>
      <a class="btn-secondary" href="https://..." data-analytics-event="click_buy_book" data-analytics-value="book_page">Buy the Book</a>
    </p>
    -->
  </section>
</Layout>
