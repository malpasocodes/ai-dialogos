---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';

const events = await getCollection('events');
const ordered = events.sort((a, b) => a.data.startDate.getTime() - b.data.startDate.getTime());

const formatDateRange = (start: Date, end?: Date) => {
  const options: Intl.DateTimeFormatOptions = { month: 'short', day: 'numeric', year: 'numeric' };
  const startText = start.toLocaleDateString(undefined, options);
  if (!end) return startText;
  const sameMonth = start.getMonth() === end.getMonth() && start.getFullYear() === end.getFullYear();
  const endOptions: Intl.DateTimeFormatOptions = sameMonth ? { day: 'numeric', year: 'numeric' } : options;
  const endText = end.toLocaleDateString(undefined, endOptions);
  return `${startText} – ${endText}`;
};
---
<Layout title="Events">
  <h1 class="text-3xl font-semibold text-foreground">Events & Workshops</h1>
  <ul class="mt-6 space-y-4">
    {ordered.map((event) => (
      <li class="card">
        <div class="flex flex-col gap-3 md:flex-row md:items-center md:justify-between">
          <div>
            <a href={`/events/${event.slug}`} class="text-lg font-semibold text-foreground transition hover:text-accent">
              {event.data.title}
            </a>
            <p class="mt-2 text-sm leading-relaxed text-muted">{event.data.summary}</p>
          </div>
          <div class="text-sm font-medium uppercase tracking-wide text-muted md:text-right">
            <div>{formatDateRange(event.data.startDate, event.data.endDate)}</div>
            <div class="mt-1 text-xs text-muted/80">{event.data.location}</div>
          </div>
        </div>
        {event.data.registrationUrl && (
          <a class="mt-4 inline-flex text-sm font-medium text-accent hover:text-accent/90" href={event.data.registrationUrl}>
            Register →
          </a>
        )}
      </li>
    ))}
  </ul>
</Layout>
