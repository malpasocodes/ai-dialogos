---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import CardGrid from '../components/CardGrid.astro';
import Seo from '../components/Seo.astro';
import { getSubstackPosts } from '../utils/substack';
import { getPodcastEpisodes } from '../utils/podcast';

const SITE_URL = import.meta.env.SITE_URL ?? 'https://ai-dialogos.com';
const canonicalImage = `${SITE_URL}/images/ai-bookcover.jpeg`;

const substackPosts = await getSubstackPosts(3);
const substackCards = substackPosts.map((post) => ({
  title: post.title,
  description: post.summary,
  href: post.link,
  meta: new Date(post.published).toLocaleDateString(undefined, {
    month: 'short',
    day: 'numeric',
    year: 'numeric',
  }),
}));

const podcastCards = (await getPodcastEpisodes())
  .sort((a, b) => new Date(b.published).getTime() - new Date(a.published).getTime())
  .slice(0, 3)
  .map((episode) => ({
    title: episode.title,
    description: episode.summary,
    href: `/podcast/${episode.slug}`,
    meta: episode.duration,
  }));
---
<Layout>
  <Fragment slot="head">
    <Seo
      renderMeta={false}
      structuredData={[
        {
          '@type': 'Book',
          name: 'Artificial Intelligence: Shaping the Future of Innovation',
          description:
            'A concise, non-technical primer on artificial intelligence for business leaders, practitioners, and policymakers.',
          author: {
            '@type': 'Person',
            name: 'Alfred Essa',
          },
          publisher: {
            '@type': 'Organization',
            name: 'De Gruyter',
          },
          datePublished: '2025-01-15',
          image: canonicalImage,
          url: new URL(Astro.url.pathname, SITE_URL).toString(),
        },
        {
          '@type': 'PodcastSeries',
          name: 'AI-Dialogos Podcast',
          description:
            'Conversations with leaders and innovators on AI strategy, ethics, and adoption.',
          url: `${SITE_URL}/podcast`,
          publisher: {
            '@type': 'Organization',
            name: 'AI-Dialogos',
          },
        },
      ]}
    />
  </Fragment>
  <Hero
    title="AI Essentials for Leaders"
    subtitle="The <em>AI Essentials for Leaders</em> book series offers concise, non-technical primers for navigating the complex world of Artificial Intelligence. This companion site provides curated resources, including Substack essays and podcast interviews."
    ctas={[
      { label: "Subscribe on Substack", href: "/substack", analytics: "subscribe_substack", analyticsValue: "hero_cta" },
      { label: "Listen to Podcast", href: "/podcast" }
    ]}
  />
  <CardGrid title="Latest Substack" items={substackCards} moreHref="/substack" compact />
  <CardGrid title="Latest Podcast" items={podcastCards} moreHref="/podcast" compact />
</Layout>
