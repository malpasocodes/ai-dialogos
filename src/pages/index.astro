---
export const prerender = true;
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import CardGrid from '../components/CardGrid.astro';
import EpisodeCard from '../components/EpisodeCard.astro';
import Seo from '../components/Seo.astro';
import { getSubstackPosts } from '../utils/substack';
import { getPodcastEpisodes, YOUTUBE_PLAYLIST_URL } from '../utils/youtube';
import innovationCover from '../../images/shaping-future-innovation.jpeg';
import strategyCover from '../../images/rethinking-business-strategy.jpeg';

const SITE_URL = import.meta.env.SITE_URL ?? 'https://ai-dialogos.com';
const canonicalImage = `${SITE_URL}/images/ai-bookcover.jpeg`;
const APPLE_PODCASTS_URL = 'https://podcasts.apple.com/us/podcast/ai-dialogos-podcast/id1884134654';
const SPOTIFY_URL = 'https://open.spotify.com/show/033qQQeIiEKw63qWMdFmPI';
const SUBSTACK_URL = 'https://aidialogos.substack.com';

const episodes = await getPodcastEpisodes(20);
const latestEpisodes = episodes.slice(0, 2);
const moreEpisodes = episodes.slice(2, 4);
const olderEpisodes = episodes.slice(4);

const substackPosts = await getSubstackPosts(3);
const substackCards = substackPosts.map((post) => ({
  title: post.title,
  description: post.summary,
  href: post.link,
  meta: new Date(post.published).toLocaleDateString(undefined, {
    month: 'short',
    day: 'numeric',
    year: 'numeric',
  }),
}));

const volumes = [
  {
    title: 'Shaping the Future of Innovation',
    href: '/volumes/shaping-the-future-of-innovation',
    cover: innovationCover,
  },
  {
    title: 'Rethinking Business Strategy',
    href: '/volumes/rethinking-business-strategy',
    cover: strategyCover,
  },
];
---
<Layout>
  <Fragment slot="head">
    <Seo
      renderMeta={false}
      structuredData={[
        {
          '@type': 'PodcastSeries',
          name: 'AI-Dialogos Podcast',
          description:
            'Conversations with leaders and innovators on AI strategy, ethics, and adoption.',
          url: APPLE_PODCASTS_URL,
          sameAs: [YOUTUBE_PLAYLIST_URL, SPOTIFY_URL],
          publisher: {
            '@type': 'Organization',
            name: 'AI-Dialogos',
          },
        },
        {
          '@type': 'Organization',
          name: 'AI-Dialogos',
          url: SITE_URL,
          sameAs: [SUBSTACK_URL, YOUTUBE_PLAYLIST_URL, APPLE_PODCASTS_URL, SPOTIFY_URL],
        },
        {
          '@type': 'Book',
          name: 'Artificial Intelligence: Shaping the Future of Innovation',
          description:
            'A concise, non-technical primer on artificial intelligence for business leaders, practitioners, and policymakers.',
          author: {
            '@type': 'Person',
            name: 'Alfred Essa',
          },
          publisher: {
            '@type': 'Organization',
            name: 'De Gruyter',
          },
          datePublished: '2025-01-15',
          image: canonicalImage,
          url: new URL(Astro.url.pathname, SITE_URL).toString(),
        },
      ]}
    />
  </Fragment>
  <Hero
    title="AI-Dialogos"
    tagline="Conversations with AI leaders"
    subtitle="A podcast and Substack series exploring AI strategy, implementation, and ethics."
    ctas={[
      { label: "Watch on YouTube", href: YOUTUBE_PLAYLIST_URL, primary: true, analytics: "watch_youtube", analyticsValue: "hero_cta" },
      { label: "Apple Podcasts", href: APPLE_PODCASTS_URL, analytics: "listen_podcast", analyticsValue: "hero_apple" },
      { label: "Spotify", href: SPOTIFY_URL, analytics: "listen_podcast", analyticsValue: "hero_spotify" },
      { label: "Substack", href: "/substack", analytics: "subscribe_substack", analyticsValue: "hero_cta" }
    ]}
  />
  {latestEpisodes.length > 0 && (
    <section class="space-y-5">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
          <h2 class="text-2xl font-semibold tracking-tight text-foreground">Latest Episodes</h2>
          <p class="mt-1 text-sm text-muted-foreground">
            Also available on
            <a href={APPLE_PODCASTS_URL} target="_blank" rel="noopener noreferrer" class="font-medium text-primary hover:underline" data-analytics-event="listen_podcast" data-analytics-value="episodes_apple">Apple Podcasts</a>
            and
            <a href={SPOTIFY_URL} target="_blank" rel="noopener noreferrer" class="font-medium text-primary hover:underline" data-analytics-event="listen_podcast" data-analytics-value="episodes_spotify">Spotify</a>.
          </p>
        </div>
        <a href="/podcast/guests" class="text-sm font-medium text-muted-foreground transition hover:text-foreground">
          Meet the guests →
        </a>
      </div>
      <div class="grid gap-6 sm:grid-cols-2">
        {latestEpisodes.map((episode) => <EpisodeCard episode={episode} />)}
      </div>
    </section>
  )}
  {moreEpisodes.length > 0 && (
    <section class="mt-12 space-y-5">
      <h2 class="text-2xl font-semibold tracking-tight text-foreground">More Episodes</h2>
      <div class="space-y-4">
        {moreEpisodes.map((episode) => <EpisodeCard episode={episode} compact />)}
      </div>
      {olderEpisodes.length > 0 && (
        <>
          <div id="older-episodes" class="space-y-4" hidden>
            {olderEpisodes.map((episode) => <EpisodeCard episode={episode} compact />)}
          </div>
          <button
            type="button"
            class="btn-secondary"
            aria-expanded="false"
            aria-controls="older-episodes"
            data-episodes-toggle
            data-label-more={`Show ${olderEpisodes.length} more ${olderEpisodes.length === 1 ? 'episode' : 'episodes'}`}
            data-label-less="Show fewer"
          >
            Show {olderEpisodes.length} more {olderEpisodes.length === 1 ? 'episode' : 'episodes'}
          </button>
        </>
      )}
    </section>
  )}
  <script>
    const toggle = document.querySelector<HTMLButtonElement>('[data-episodes-toggle]');
    const list = document.getElementById('older-episodes');
    toggle?.addEventListener('click', () => {
      if (!list) return;
      const expand = list.hidden;
      list.hidden = !expand;
      toggle.setAttribute('aria-expanded', String(expand));
      toggle.textContent = (expand ? toggle.dataset.labelLess : toggle.dataset.labelMore) ?? '';
    });
  </script>
  <CardGrid title="Latest Essays" items={substackCards} moreHref="/substack" compact />
  <section class="mt-12 rounded-2xl border border-border bg-card p-6 shadow-lg sm:p-8">
    <div class="flex flex-col gap-8 md:flex-row md:items-center">
      <div class="flex flex-none gap-4">
        {volumes.map((v) => (
          <a href={v.href} class="block w-24 transition hover:-translate-y-0.5 sm:w-28">
            <img
              src={v.cover.src}
              width={v.cover.width}
              height={v.cover.height}
              alt={`${v.title} cover`}
              loading="lazy"
              decoding="async"
              class="w-full rounded-xl shadow-card"
            />
          </a>
        ))}
      </div>
      <div class="space-y-3">
        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-primary">From the book series</p>
        <h2 class="text-2xl font-semibold tracking-tight text-foreground">AI Essentials for Leaders</h2>
        <p class="text-base leading-relaxed text-muted-foreground">
          Concise, non-technical primers on artificial intelligence for business leaders, practitioners, and policymakers, published by De Gruyter Brill and co-edited by Alfred Essa and Teresa Martín-Retortillo.
        </p>
        <div class="flex flex-wrap gap-x-5 gap-y-2 text-sm font-medium">
          <a href="/series" class="text-primary hover:underline">Series overview →</a>
          {volumes.map((v) => (
            <a href={v.href} class="text-muted-foreground transition hover:text-foreground">{v.title}</a>
          ))}
        </div>
      </div>
    </div>
  </section>
</Layout>
