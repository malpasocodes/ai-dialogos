---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import CardGrid from '../components/CardGrid.astro';
import Seo from '../components/Seo.astro';
import { getSubstackPosts } from '../utils/substack';
import { getPodcastEpisodes } from '../utils/podcast';

const SITE_URL = import.meta.env.SITE_URL ?? 'https://ai-innov.example.com';
const canonicalImage = `${SITE_URL}/images/ai-bookcover.jpeg`;

const modules = await getCollection('modules');
const substackPosts = await getSubstackPosts(3);
const moduleCards = modules
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3)
  .map((entry) => ({
    title: entry.data.title,
    description: entry.data.summary,
    href: `/modules/${entry.slug}`,
    meta: `Module ${entry.data.order}`,
  }));

const substackCards = substackPosts.map((post) => ({
  title: post.title,
  description: post.summary,
  href: post.link,
  meta: new Date(post.published).toLocaleDateString(undefined, {
    month: 'short',
    day: 'numeric',
    year: 'numeric',
  }),
}));

const resources = await getCollection('resources');
const resourceCards = resources.slice(0, 3).map((entry) => ({
  title: entry.data.title,
  description: entry.data.summary,
  href: `/resources/${entry.slug}`,
  meta: entry.data.type.replace('-', ' '),
}));

const podcastCards = (await getPodcastEpisodes())
  .sort((a, b) => new Date(b.published).getTime() - new Date(a.published).getTime())
  .slice(0, 3)
  .map((episode) => ({
    title: episode.title,
    description: episode.summary,
    href: `/podcast/${episode.slug}`,
    meta: episode.duration,
  }));
---
<Layout>
  <Fragment slot="head">
    <Seo
      renderMeta={false}
      structuredData={[
        {
          '@type': 'Book',
          name: 'Artificial Intelligence: Shaping the Future of Innovation',
          description:
            'Educator-friendly companion book exploring innovation, governance, and AI adoption strategies for higher education.',
          author: {
            '@type': 'Person',
            name: 'Monads Collective',
          },
          publisher: {
            '@type': 'Organization',
            name: 'De Gruyter',
          },
          datePublished: '2025-01-15',
          image: canonicalImage,
          url: new URL(Astro.url.pathname, SITE_URL).toString(),
        },
        {
          '@type': 'PodcastSeries',
          name: 'AI-Innov Podcast',
          description:
            'Conversations with educators and innovators on responsible AI adoption and curriculum design.',
          url: `${SITE_URL}/podcast`,
          publisher: {
            '@type': 'Organization',
            name: 'AI-Innov',
          },
        },
      ]}
    />
  </Fragment>
  <Hero
    title="AI Essentials for Leaders"
    subtitle="The <em>AI Essentials for Leaders</em> book series offers concise, non-technical primers for navigating the complex world of Artificial Intelligence. This companion site provides curated resources, including Substack essays and podcast interviews."
    ctas={[
      { label: "Explore Educator Hub", href: "/educators", primary: true },
      { label: "Buy Book", href: "/book", analytics: "click_buy_book", analyticsValue: "hero_cta" },
      { label: "Subscribe on Substack", href: "/substack", analytics: "subscribe_substack", analyticsValue: "hero_cta" },
      { label: "Listen to Podcast", href: "/podcast" }
    ]}
  />
  <CardGrid title="Featured Modules" items={moduleCards} moreHref="/educators" />
  <CardGrid title="Latest Substack Essays" items={substackCards} moreHref="/substack" />
  <CardGrid title="Educator Resources" items={resourceCards} moreHref="/resources" />
  <CardGrid title="Podcast Highlights" items={podcastCards} moreHref="/podcast" />
</Layout>
