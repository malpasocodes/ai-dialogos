---
import Layout from '../layouts/Layout.astro';
import Seo from '../components/Seo.astro';
import { getPodcastEpisodes } from '../utils/podcast';

const SITE_URL = import.meta.env.SITE_URL ?? 'https://ai-innov.example.com';

const ordered = (await getPodcastEpisodes()).sort((a, b) => {
  const aDate = new Date(a.published).getTime();
  const bDate = new Date(b.published).getTime();
  return bDate - aDate;
});
---
<Layout title="Podcast">
  <Fragment slot="head">
    <Seo
      renderMeta={false}
      structuredData={{
        '@type': 'PodcastSeries',
        name: 'AI-Innov Podcast',
        description: 'Conversations with educators and innovators on responsible AI adoption and curriculum design.',
        url: new URL(Astro.url.pathname, SITE_URL).toString(),
        publisher: {
          '@type': 'Organization',
          name: 'AI-Innov',
        },
      }}
    />
  </Fragment>
  <h1 class="text-3xl font-semibold text-foreground">Podcast</h1>
  <p class="mt-3 max-w-2xl text-base leading-relaxed text-muted">Conversations with educators and innovators.</p>
  <div class="mt-6 flex flex-wrap items-center gap-3">
    <a
      href="https://www.youtube.com/playlist?list=PL2QoJOg_E8XD5V_8JKTj3fw-KKQetn_TK"
      class="btn-secondary"
      target="_blank"
      rel="noopener noreferrer"
      data-analytics-event="podcast_playlist"
      data-analytics-value="youtube"
    >
      Watch on YouTube
    </a>
  </div>
  <div class="mt-8 space-y-5">
    {ordered.map((episode) => (
      <article class="card" id={episode.slug}>
        <header class="flex flex-col gap-2 md:flex-row md:items-center md:justify-between">
          <div>
            <h3 class="text-lg font-semibold text-foreground">
              <a href={`/podcast/${episode.slug}`} class="transition hover:text-accent">
                {episode.title}
              </a>
            </h3>
            <p class="text-xs font-medium uppercase tracking-wide text-muted">
              {new Date(episode.published).toLocaleDateString(undefined, {
                month: 'short',
                day: 'numeric',
                year: 'numeric',
              })}
            </p>
          </div>
          {episode.duration && (
            <span class="text-xs font-medium uppercase tracking-wide text-muted">{episode.duration}</span>
          )}
        </header>
        <p class="mt-3 text-sm leading-relaxed text-muted">{episode.summary}</p>
        <div class="mt-4 flex flex-wrap items-center gap-3">
          {episode.image && (
            <a
              href={`/podcast/${episode.slug}`}
              class="block w-full max-w-[140px] overflow-hidden rounded-2xl border border-outline/20 bg-surface-soft/80 transition hover:border-outline/30"
            >
              <img
                src={episode.image}
                alt={`Thumbnail for ${episode.title}`}
                loading="lazy"
                class="h-auto w-full object-cover"
              />
            </a>
          )}
          <div class="flex flex-wrap gap-2">
            <a href={`/podcast/${episode.slug}`} class="btn-secondary">Episode details</a>
            <a
              href={episode.videoUrl}
              class="btn-secondary"
              target="_blank"
              rel="noopener noreferrer"
              data-analytics-event="watch_episode"
              data-analytics-value={episode.videoId || episode.slug}
            >
              Watch on YouTube
            </a>
          </div>
        </div>
      </article>
    ))}
  </div>
</Layout>
