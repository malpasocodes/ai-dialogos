---
import Layout from '../layouts/Layout.astro';
import { getPodcastEpisodes } from '../utils/podcast';

const ordered = (await getPodcastEpisodes()).sort((a, b) => {
  const aDate = new Date(a.published).getTime();
  const bDate = new Date(b.published).getTime();
  return bDate - aDate;
});
---
<Layout title="Podcast">
  <h1 class="text-3xl font-semibold text-foreground">Podcast</h1>
  <p class="mt-3 max-w-2xl text-base leading-relaxed text-muted">Conversations with educators and innovators.</p>
  <div class="mt-8 space-y-5">
    {ordered.map((episode) => (
      <article class="card" id={episode.slug}>
        <header class="flex flex-col gap-2 md:flex-row md:items-center md:justify-between">
          <div>
            <h3 class="text-lg font-semibold text-foreground">
              <a href={`/podcast/${episode.slug}`} class="transition hover:text-accent">
                {episode.title}
              </a>
            </h3>
            <p class="text-xs font-medium uppercase tracking-wide text-muted">
              {new Date(episode.published).toLocaleDateString(undefined, {
                month: 'short',
                day: 'numeric',
                year: 'numeric',
              })}
            </p>
          </div>
          {episode.duration && (
            <span class="text-xs font-medium uppercase tracking-wide text-muted">{episode.duration}</span>
          )}
        </header>
        <p class="mt-3 text-sm leading-relaxed text-muted">{episode.summary}</p>
        <div class="mt-4 overflow-hidden rounded-2xl border border-outline/20 bg-surface-soft/80 p-3">
          <audio class="w-full" controls src={episode.audioUrl}>
            <a href={episode.audioUrl}>Listen to {episode.title}</a>
          </audio>
        </div>
      </article>
    ))}
  </div>
</Layout>
