---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';

const episodes = await getCollection('podcast');
const ordered = episodes.sort((a, b) => b.data.episodeNumber - a.data.episodeNumber);
---
<Layout title="Podcast">
  <h1 class="text-3xl font-semibold text-foreground">Podcast</h1>
  <p class="mt-3 max-w-2xl text-base leading-relaxed text-muted">Conversations with educators and innovators.</p>
  <div class="mt-8 space-y-5">
    {ordered.map((episode) => (
      <article class="card" id={episode.slug}>
        <header class="flex flex-col gap-2 md:flex-row md:items-center md:justify-between">
          <div>
            <h3 class="text-lg font-semibold text-foreground">
              <a href={`/podcast/${episode.slug}`} class="transition hover:text-accent">
                Ep {episode.data.episodeNumber} — {episode.data.title}
              </a>
            </h3>
            <p class="text-xs font-medium uppercase tracking-wide text-muted">
              {episode.data.published.toLocaleDateString(undefined, { month: 'short', day: 'numeric', year: 'numeric' })}
            </p>
          </div>
          {episode.data.duration && <span class="text-xs font-medium uppercase tracking-wide text-muted">{episode.data.duration}</span>}
        </header>
        <p class="mt-3 text-sm leading-relaxed text-muted">{episode.data.summary}</p>
        <div class="mt-4 overflow-hidden rounded-2xl border border-outline/20 bg-surface-soft/80 p-3">
          <audio class="w-full" controls src={episode.data.audioUrl}>
            <a href={episode.data.audioUrl}>Listen to {episode.data.title}</a>
          </audio>
        </div>
        {episode.data.guests.length > 0 && (
          <p class="mt-2 text-xs uppercase tracking-wide text-muted">Guests: {episode.data.guests.join(', ')}</p>
        )}
      </article>
    ))}
  </div>
</Layout>
