---
export const prerender = true;
import Layout from '../layouts/Layout.astro';
import Seo from '../components/Seo.astro';
import { getPodcastEpisodes } from '../utils/podcast';

const SITE_URL = import.meta.env.SITE_URL ?? 'https://ai-dialogos.com';
const episodes = await getPodcastEpisodes();
---
<Layout title="Podcast">
  <Fragment slot="head">
    <Seo
      renderMeta={false}
      structuredData={{
        '@type': 'PodcastSeries',
        name: 'AI-Dialogos Podcast',
        description: 'Structured conversations on AI strategy, governance, ethics, and leadership — companion to the AI Essentials for Leaders book series.',
        url: new URL(Astro.url.pathname, SITE_URL).toString(),
        publisher: {
          '@type': 'Organization',
          name: 'AI-Dialogos',
        },
      }}
    />
  </Fragment>
  <section class="space-y-3">
    <h1 class="text-3xl font-semibold text-foreground">Podcast</h1>
    <p class="max-w-2xl text-base leading-relaxed text-muted-foreground">
      Structured conversations on AI strategy, governance, ethics, and leadership. New episodes refresh on each production build.
    </p>
  </section>
  <div class="mt-6 flex flex-wrap items-center gap-3">
    <a
      href="https://aidialogos.substack.com"
      class="btn-secondary"
      target="_blank"
      rel="noopener noreferrer"
      data-analytics-event="podcast_subscribe"
      data-analytics-value="substack"
    >
      Subscribe on Substack
    </a>
  </div>
  {episodes.length === 0 ? (
    <p class="mt-8 text-sm text-muted-foreground">No episodes available yet. Check back soon.</p>
  ) : (
    <div class="mt-8 space-y-5">
      {episodes.map((episode) => (
        <article class="card space-y-3">
          <header class="flex flex-col gap-2 md:flex-row md:items-center md:justify-between">
            <div class="space-y-1">
              <p class="text-xs font-medium uppercase tracking-wide text-muted-foreground">
                {new Date(episode.published).toLocaleDateString(undefined, {
                  month: 'short',
                  day: 'numeric',
                  year: 'numeric',
                })}
              </p>
              <h2 class="text-xl font-semibold text-foreground">
                <a href={episode.link} class="transition hover:text-primary" rel="noopener" target="_blank">
                  {episode.title}
                </a>
              </h2>
            </div>
            {episode.duration && (
              <span class="text-xs font-medium uppercase tracking-wide text-muted-foreground">{episode.duration}</span>
            )}
          </header>
          {episode.summary && <p class="text-sm leading-relaxed text-muted-foreground">{episode.summary}</p>}
          <div class="flex flex-wrap items-center gap-3">
            <a
              href={episode.link}
              class="btn-secondary"
              target="_blank"
              rel="noopener noreferrer"
              data-analytics-event="listen_episode"
              data-analytics-value={episode.title}
            >
              Listen on Substack
            </a>
          </div>
        </article>
      ))}
    </div>
  )}
</Layout>
