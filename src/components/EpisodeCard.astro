---
import type { PodcastEpisode } from "../utils/youtube";

interface Props {
  episode: PodcastEpisode;
}

const { episode } = Astro.props as Props;

const publishedLabel = new Date(episode.published).toLocaleDateString(undefined, {
  month: "short",
  day: "numeric",
  year: "numeric",
});
---
<a
  href={episode.url}
  target="_blank"
  rel="noopener noreferrer"
  class="card group block overflow-hidden p-0"
  data-analytics-event="watch_episode"
  data-analytics-value={episode.videoId}
>
  <div class="relative aspect-video overflow-hidden bg-secondary">
    <img
      src={episode.thumbnail}
      alt={`Video thumbnail for ${episode.title}`}
      loading="lazy"
      decoding="async"
      class="h-full w-full object-cover transition duration-300 group-hover:scale-[1.03]"
    />
    <span class="absolute inset-0 flex items-center justify-center">
      <span class="flex h-14 w-14 items-center justify-center rounded-full bg-background/80 text-foreground shadow-lg backdrop-blur transition group-hover:bg-primary group-hover:text-primary-foreground">
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" class="ml-1 h-6 w-6">
          <path d="M8 5.14v13.72L19 12 8 5.14z" />
        </svg>
      </span>
    </span>
  </div>
  <div class="space-y-3 p-6">
    <div class="flex items-start justify-between gap-3">
      <h3 class="text-lg font-semibold text-foreground">{episode.title}</h3>
      <span class="whitespace-nowrap text-xs font-medium uppercase tracking-wide text-muted-foreground">{publishedLabel}</span>
    </div>
    {episode.summary && (
      <p class="text-sm leading-relaxed text-muted-foreground">{episode.summary}</p>
    )}
    <span class="inline-flex items-center gap-1 text-sm font-medium text-primary">
      Watch on YouTube
      <span aria-hidden="true">→</span>
    </span>
  </div>
</a>
