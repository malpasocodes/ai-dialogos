---
const { title, href = '#', description, meta } = Astro.props;
---
<a href={href} class="card block">
  <div class="flex items-center justify-between gap-3">
    <h3 class="text-lg font-semibold text-foreground">{title}</h3>
    {meta && <span class="text-xs font-medium uppercase tracking-wide text-muted">{meta}</span>}
  </div>
  {description && <p class="mt-3 text-sm leading-relaxed text-muted">{description}</p>}
</a>
