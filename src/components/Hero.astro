---
interface CTA {
  label: string;
  href: string;
  primary?: boolean;
  analytics?: string;
  analyticsValue?: string;
}

interface Props {
  title: string;
  tagline?: string;
  subtitle: string;
  ctas?: CTA[];
}

const { title, tagline, subtitle, ctas = [] } = Astro.props as Props;
---
<section class="py-10 md:py-14">
  <h1 class="text-4xl font-semibold leading-tight text-foreground md:text-6xl">{title}</h1>
  {tagline && (
    <p class="mt-3 text-xl font-medium text-foreground md:text-2xl">{tagline}</p>
  )}
  <p class="mt-5 text-lg leading-relaxed text-muted-foreground" set:html={subtitle}></p>
  <div class="mt-8 flex flex-wrap gap-3">
    {ctas.map((c) => (
      <a
        href={c.href}
        class={c.primary ? 'btn-primary' : 'btn-secondary'}
        data-analytics-event={c.analytics}
        data-analytics-value={c.analyticsValue}
        {...(c.href.startsWith('http') ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
      >
        {c.label}
      </a>
    ))}
  </div>
</section>
