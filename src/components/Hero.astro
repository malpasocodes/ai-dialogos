---
const { title, subtitle, ctas = [] } = Astro.props;
---
<section class="py-10 md:py-16">
  <div class="grid items-center gap-10 md:grid-cols-[1.2fr,0.8fr]">
    <div>
      <h1 class="text-4xl font-semibold leading-tight md:text-6xl">{title}</h1>
      <p class="mt-5 max-w-2xl text-lg leading-relaxed text-muted">{subtitle}</p>
      <div class="mt-8 flex flex-wrap gap-3">
        {ctas.map((c) => (
          <a href={c.href} class={c.primary ? 'btn-primary' : 'btn-secondary'}>
            {c.label}
          </a>
        ))}
      </div>
      <div class="mt-8 flex flex-wrap gap-2">
        <span class="badge">Educator-focused</span>
        <span class="badge">Open Resources</span>
        <span class="badge">Podcast</span>
      </div>
    </div>
    <div class="card">
      <div class="grid aspect-[3/4] w-full place-items-center rounded-3xl border border-outline/15 bg-surface-soft text-sm uppercase tracking-[0.2em] text-muted">
        Book Cover
      </div>
    </div>
  </div>
</section>
