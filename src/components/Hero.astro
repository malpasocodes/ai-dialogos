---
import coverImage from "../../images/ai-bookcover.jpeg";

interface CTA {
  label: string;
  href: string;
  primary?: boolean;
  analytics?: string;
  analyticsValue?: string;
}

interface Props {
  title: string;
  subtitle: string;
  ctas?: CTA[];
}

const { title, subtitle, ctas = [] } = Astro.props as Props;
---
<section class="py-10 md:py-16">
  <div class="grid items-center gap-10 md:grid-cols-[1.2fr,0.8fr]">
    <div>
      <h1 class="text-4xl font-semibold leading-tight md:text-6xl">{title}</h1>
      <p class="mt-5 max-w-2xl text-lg leading-relaxed text-muted">{subtitle}</p>
      <div class="mt-8 flex flex-wrap gap-3">
        {ctas.map((c) => (
          <a
            href={c.href}
            class={c.primary ? 'btn-primary' : 'btn-secondary'}
            data-analytics-event={c.analytics}
            data-analytics-value={c.analyticsValue}
          >
            {c.label}
          </a>
        ))}
      </div>
      <div class="mt-8 flex flex-wrap gap-2">
        <span class="badge">Educator-focused</span>
        <span class="badge">Open Resources</span>
        <span class="badge">Podcast</span>
      </div>
    </div>
    <div class="relative flex items-center justify-center">
      <div class="card overflow-hidden border-outline/20 bg-gradient-to-br from-surface via-surface-soft to-surface-strong p-4">
        <figure class="relative mx-auto w-full max-w-xs md:max-w-sm">
          <div class="absolute inset-0 -z-10 rounded-3xl bg-accent/25 blur-3xl"></div>
          <img
            src={coverImage.src}
            width={coverImage.width}
            height={coverImage.height}
            alt="Artificial Intelligence: Shaping the Future of Innovation book cover"
            loading="lazy"
            decoding="async"
            class="w-full rounded-3xl shadow-card"
          />
        </figure>
      </div>
    </div>
  </div>
</section>
