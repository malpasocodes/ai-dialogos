---
const { title, items = [], moreHref, compact = false } = Astro.props;
import Card from './Card.astro';
---
<section class="mt-12 space-y-4">
  <div class="flex items-center justify-between gap-4">
    <h2 class="text-2xl font-semibold tracking-tight text-[#1f4c9a]">{title}</h2>
    {moreHref && (
      <a href={moreHref} class="text-sm font-medium text-muted transition hover:text-foreground">
        View all →
      </a>
    )}
  </div>
  <div class={`grid gap-5 ${compact ? 'sm:grid-cols-2 lg:grid-cols-4' : 'sm:grid-cols-2 md:grid-cols-3'}`}>
    {items.map((it) => <Card {...it} compact={compact} />)}
  </div>
</section>
