---
const { title = "AI Essentials for Leaders", description = "Companion site for the AI Essentials for Leaders book series (De Gruyter Brill)." } = Astro.props;
const currentPath = Astro.url.pathname;
const navItems = [
  { label: "Series", href: "/series" },
  {
    label: "Volumes",
    children: [
      { label: "Shaping the Future of Innovation", href: "/volumes/shaping-the-future-of-innovation" },
      { label: "Rethinking Business Strategy", href: "/volumes/rethinking-business-strategy" },
    ],
  },
  { label: "Substack", href: "/substack" },
  {
    label: "Podcast",
    children: [
      { label: "Overview", href: "/podcast" },
      { label: "Guests", href: "/podcast/guests" },
    ],
  },
  { label: "About", href: "/about" },
];
import '../styles/global.css';
import Seo from '../components/Seo.astro';
import { ThemeSelector } from '../components/ThemeSelector';
import { UserButton } from '../components/UserButton';
const PLAUSIBLE_DOMAIN = import.meta.env.PLAUSIBLE_DOMAIN;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {PLAUSIBLE_DOMAIN && (
      <script defer data-domain={PLAUSIBLE_DOMAIN} src="https://plausible.io/js/script.manual.js"></script>
    )}
    <Seo title={title} description={description} />
    <slot name="head" />
  </head>
  <body>
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 btn-secondary">Skip to content</a>
    <header class="site-header sticky top-0 z-50 border-b border-border/15">
      <div class="container flex items-center justify-between gap-4 py-3">
        <a href="/" class="brand-link inline-flex items-center gap-2 text-base font-display font-semibold tracking-tight">
          <span class="brand-text">AI-DIALOGOS</span>
        </a>
        <nav class="hidden items-center gap-2 md:flex">
          {navItems.map((item) => {
            const children = item.children ?? [];
            const isActive = item.href
              ? currentPath === item.href || currentPath.startsWith(`${item.href}/`)
              : children.some((child) => currentPath === child.href || currentPath.startsWith(`${child.href}/`));
            if (children.length > 0) {
              return (
                <div class="nav-dropdown group relative">
                  <button class="nav-link inline-flex items-center gap-1" type="button" data-active={isActive}>
                    {item.label}
                    <svg
                      class="h-3 w-3 transition-transform group-hover:-rotate-180"
                      viewBox="0 0 12 12"
                      fill="none"
                      aria-hidden="true"
                    >
                      <path d="M3 4.5l3 3 3-3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                  </button>
                  <div class="nav-dropdown-panel">
                    {children.map((child) => (
                      <a
                        href={child.href}
                        class="nav-dropdown-link"
                        data-active={currentPath === child.href || currentPath.startsWith(`${child.href}/`)}
                      >
                        {child.label}
                      </a>
                    ))}
                  </div>
                </div>
              );
            }
            return (
              <a href={item.href} class="nav-link" data-active={isActive}>
                {item.label}
              </a>
            );
          })}
        </nav>
        <div class="flex items-center gap-2">
          <ThemeSelector client:load />
          <UserButton client:only="react" />
        </div>
      </div>
    </header>
    <main id="main" class="container py-14">
      <slot />
    </main>
    <footer class="mt-18 border-t border-border/15 bg-card/60">
      <div class="container py-10 text-sm text-muted-foreground">
        <div class="grid gap-8 md:grid-cols-3">
          <div>
            <div class="font-semibold text-foreground">About</div>
            <p class=”mt-3 text-sm leading-relaxed text-muted-foreground”>
              Companion site for the <em>AI Essentials for Leaders</em> book series (De Gruyter Brill). Curated resources, Substack essays, and podcast conversations.
            </p>
          </div>
          <div>
            <div class="font-semibold text-foreground">Quick links</div>
            <ul class="mt-3 space-y-1.5 text-sm">
              <li><span class="font-semibold text-foreground">Volumes</span></li>
              <li><a href="/volumes/shaping-the-future-of-innovation" class="transition hover:text-foreground">Shaping the Future of Innovation</a></li>
              <li><a href="/volumes/rethinking-business-strategy" class="transition hover:text-foreground">Rethinking Business Strategy</a></li>
              <li><a href="/podcast" class="transition hover:text-foreground">Podcast</a></li>
              <li><a href="/substack" class="transition hover:text-foreground">Substack</a></li>
            </ul>
          </div>
          <div>
            <div class="font-semibold text-foreground">Stay in touch</div>
            <form class="mt-3 flex gap-2" onsubmit="return false" aria-label="Subscribe to newsletter">
              <input
                type="email"
                placeholder="you@example.edu"
                class="w-full rounded-pill border border-border/20 bg-card px-3 py-2 text-sm text-foreground placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent/60 focus-visible:ring-offset-2 focus-visible:ring-offset-background"
              />
              <button class="btn-primary" data-analytics-event="subscribe_substack" data-analytics-value="footer_form">Subscribe</button>
            </form>
          </div>
        </div>
        <p class="mt-8 text-xs uppercase tracking-wide text-muted-foreground">© {new Date().getFullYear()} • All rights reserved.</p>
      </div>
    </footer>
    <script type="module">
      const trackEvent = (name, value) => {
        if (typeof window === 'undefined' || !window.plausible) return;
        if (!name) return;
        window.plausible(name, value ? { props: { value } } : undefined);
      };

      document.querySelectorAll('[data-analytics-event]').forEach((element) => {
        const eventName = element.dataset.analyticsEvent;
        const eventValue = element.dataset.analyticsValue;
        element.addEventListener('click', () => trackEvent(eventName, eventValue));
      });

      document.querySelectorAll('audio[data-analytics-event]').forEach((audio) => {
        const eventName = audio.dataset.analyticsEvent;
        const eventValue = audio.dataset.analyticsValue;
        let fired = false;
        audio.addEventListener('play', () => {
          if (!fired) {
            fired = true;
            trackEvent(eventName, eventValue);
          }
        });
      });
    </script>
  </body>
</html>
