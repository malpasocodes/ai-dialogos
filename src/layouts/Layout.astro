---
const { title = "AI: Shaping the Future of Innovation", description = "Educator-friendly companion site for the 2025 book." } = Astro.props;
const currentPath = Astro.url.pathname;
const navItems = [
  { label: "Book", href: "/book" },
  { label: "Educators", href: "/educators" },
  { label: "Resources", href: "/resources" },
  { label: "Podcast", href: "/podcast" },
  { label: "Events", href: "/events" },
  { label: "About", href: "/about" },
];
import '../styles/global.css';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <slot name="head" />
    <title>{title}</title>
  </head>
  <body>
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 btn-secondary">Skip to content</a>
    <header class="sticky top-0 z-50 border-b border-outline/15 bg-background/80 backdrop-blur supports-[backdrop-filter]:bg-background/60">
      <div class="container flex items-center justify-between gap-4 py-3">
        <a href="/" class="text-base font-display font-semibold tracking-tight text-foreground">AI: Innovation (Book 2025)</a>
        <nav class="hidden items-center gap-2 md:flex">
          {navItems.map((item) => (
            <a
              href={item.href}
              class="nav-link"
              data-active={currentPath === item.href || currentPath.startsWith(`${item.href}/`)}
            >
              {item.label}
            </a>
          ))}
        </nav>
        <div class="flex items-center gap-2">
          <button type="button" class="btn-ghost hidden md:inline-flex" data-theme-toggle aria-label="Toggle theme">
            <span data-theme-text>Indigo</span>
          </button>
          <button type="button" class="btn-ghost md:hidden" data-theme-toggle aria-label="Toggle theme">
            🎨
          </button>
          <a href="/search" class="btn-secondary hidden shrink-0 md:inline-flex">Search</a>
          <a href="/search" class="btn-secondary md:hidden" aria-label="Search">
            🔍
          </a>
        </div>
      </div>
    </header>
    <main id="main" class="container py-14">
      <slot />
    </main>
    <footer class="mt-18 border-t border-outline/15 bg-surface-soft/60">
      <div class="container py-10 text-sm text-muted">
        <div class="grid gap-8 md:grid-cols-3">
          <div>
            <div class="font-semibold text-foreground">About</div>
            <p class="mt-3 text-sm leading-relaxed text-muted">
              Companion site for the book “Artificial Intelligence: Shaping the Future of Innovation” (De Gruyter, 2025).
            </p>
          </div>
          <div>
            <div class="font-semibold text-foreground">Quick links</div>
            <ul class="mt-3 space-y-1.5 text-sm">
              <li><a href="/book" class="transition hover:text-foreground">Book</a></li>
              <li><a href="/educators" class="transition hover:text-foreground">Educator Hub</a></li>
              <li><a href="/resources" class="transition hover:text-foreground">Resources</a></li>
              <li><a href="/podcast" class="transition hover:text-foreground">Podcast</a></li>
              <li><a href="/events" class="transition hover:text-foreground">Events</a></li>
            </ul>
          </div>
          <div>
            <div class="font-semibold text-foreground">Stay in touch</div>
            <form class="mt-3 flex gap-2" onsubmit="return false" aria-label="Subscribe to newsletter">
              <input
                type="email"
                placeholder="you@example.edu"
                class="w-full rounded-pill border border-outline/20 bg-surface-soft px-3 py-2 text-sm text-foreground placeholder:text-muted focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent/60 focus-visible:ring-offset-2 focus-visible:ring-offset-background"
              />
              <button class="btn-primary">Subscribe</button>
            </form>
          </div>
        </div>
        <p class="mt-8 text-xs uppercase tracking-wide text-muted">© {new Date().getFullYear()} • All rights reserved.</p>
      </div>
    </footer>
    <script type="module">
      const themes = ["indigo", "emerald"];
      const storageKey = "ai-innov-theme";
      const root = document.documentElement;
      const stored = typeof localStorage !== "undefined" ? localStorage.getItem(storageKey) : null;
      if (stored && themes.includes(stored)) {
        root.dataset.theme = stored;
      } else if (!root.dataset.theme) {
        root.dataset.theme = themes[0];
      }

      const updateButtons = (theme) => {
        const nextTheme = theme === themes[0] ? themes[1] : themes[0];
        document.querySelectorAll('[data-theme-toggle]').forEach((button) => {
          button.setAttribute('aria-label', `Switch to ${nextTheme} theme`);
        });
        document.querySelectorAll('[data-theme-text]').forEach((el) => {
          el.textContent = theme.charAt(0).toUpperCase() + theme.slice(1);
        });
      };

      updateButtons(root.dataset.theme);

      document.querySelectorAll('[data-theme-toggle]').forEach((button) => {
        button.addEventListener('click', () => {
          const current = root.dataset.theme ?? themes[0];
          const next = current === themes[0] ? themes[1] : themes[0];
          root.dataset.theme = next;
          try {
            localStorage.setItem(storageKey, next);
          } catch (error) {
            console.warn('Unable to persist theme preference', error);
          }
          updateButtons(next);
        });
      });
    </script>
  </body>
</html>
